MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=lajjas_foods

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Configure Google and email/password sign-in in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/products/all-products/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/products/all-products/
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-cloud-api-phone-number-id
# Use an opted-in WhatsApp recipient that is not the Cloud API sender number.
WHATSAPP_RECIPIENT_PHONE_NUMBER=919876543210
WHATSAPP_GRAPH_API_VERSION=v25.0
# This approved template must have six body variables in order: name, phone, email, city, subject, message.
WHATSAPP_TEMPLATE_NAME=website_contact_inquiry
WHATSAPP_TEMPLATE_LANGUAGE=en_US
